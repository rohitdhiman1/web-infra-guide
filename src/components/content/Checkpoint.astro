---
/** The end-of-module self-check. Usage: <Checkpoint> - item - item </Checkpoint>. title="" hides the title. */
interface Props {
  title?: string;
}
const { title = 'Without notes, you can:' } = Astro.props;
---

<aside class="checkpoint" aria-label={title}>
  {title && <p class="checkpoint-title">{title}</p>}
  <div class="checkpoint-body"><slot /></div>
</aside>
